{
  "http_host": {
    "type": "string",
    "default": "localhost",
    "hint": "OneBot HTTP server address"
  },
  "http_port": {
    "type": "integer",
    "default": 3000,
    "hint": "OneBot HTTP port"
  },
  "access_token": {
    "type": "string",
    "default": "",
    "hint": "Access token if set in OneBot"
  },
  "use_ws": {
    "type": "switch",
    "default": true,
    "hint": "优先使用适配器 WS 通道拉取历史（与转发/撤回同一 ID 命名空间，SnowLuma 下 get_msg 可反查）；关闭则仅用 HTTP 通道"
  },
  "master_id": {
    "type": "string",
    "default": "",
    "hint": "主人QQ号，拥有所有权限"
  },
  "allowed_users": {
    "type": "string",
    "default": "",
    "hint": "其他允许使用该工具的用户QQ，多个用逗号分隔"
  },
  "restricted_groups": {
    "type": "string",
    "default": "",
    "hint": "只有主人能查看的群聊QQ群号，多个用逗号分隔"
  }
}
